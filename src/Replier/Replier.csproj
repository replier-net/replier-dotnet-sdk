<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Replier</RootNamespace>
    <AssemblyName>Replier</AssemblyName>

    <PackageId>Replier.Sdk</PackageId>
    <Version>1.0.0</Version>
    <Authors>Replier.net</Authors>
    <Description>Official .NET SDK for the Replier.net WhatsApp API</Description>
    <PackageTags>whatsapp;replier;api;sdk;messaging</PackageTags>
    <PackageProjectUrl>https://www.replier.net</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
